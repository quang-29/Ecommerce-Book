<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-provinces" author="quangnm">
        <createTable tableName="provinces">
            <column name="id" type="INT">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="002-create-districts" author="quangnm">
        <createTable tableName="districts">
            <column name="id" type="INT">
                <constraints primaryKey="true"/>
            </column>
            <column name="province_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_districts_province" references="provinces(id)"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="003-create-wards" author="quangnm">
        <createTable tableName="wards">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true"/>
            </column>
            <column name="district_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_wards_district" references="districts(id)"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="004-create-user-address" author="quangnm">
        <createTable tableName="user_address">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="province_id" type="INT">
                <constraints foreignKeyName="fk_user_address_province" references="provinces(id)"/>
            </column>
            <column name="district_id" type="INT">
                <constraints foreignKeyName="fk_user_address_district" references="districts(id)"/>
            </column>
            <column name="ward_id" type="VARCHAR(255)">
                <constraints foreignKeyName="fk_user_address_ward" references="wards(id)"/>
            </column>
            <column name="detail" type="VARCHAR(255)"/>
            <column name="username" type="VARCHAR(255)"/>
            <column name="receiver_name" type="VARCHAR(255)"/>
            <column name="phone_number" type="VARCHAR(255)"/>
            <column name="is_primary" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
