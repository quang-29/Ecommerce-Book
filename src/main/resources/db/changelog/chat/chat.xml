<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-room" author="quangnm">
        <createTable tableName="room">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="room_id" type="VARCHAR(255)">
                <constraints unique="true" uniqueConstraintName="uk_room_room_id"/>
            </column>
            <column name="user_id" type="BIGINT"/>
            <column name="user_avatar" type="VARCHAR(255)"/>
            <column name="user_name" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>
    </changeSet>

    <changeSet id="002-create-message" author="quangnm">
        <createTable tableName="message">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="room_id" type="VARCHAR(255)"/>
            <column name="sender" type="VARCHAR(255)"/>
            <column name="sender_url" type="VARCHAR(255)"/>
            <column name="content" type="VARCHAR(255)"/>
            <column name="sent_at" type="DATETIME"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
