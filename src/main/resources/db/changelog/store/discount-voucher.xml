<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-add-book-discount" author="quangnm">
        <addColumn tableName="book">
            <column name="discount_percent" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="002-add-order-item-discount-snapshot" author="quangnm">
        <addColumn tableName="order_items">
            <column name="discount_percent" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="discount_amount" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="003-add-payment-discount" author="quangnm">
        <addColumn tableName="payment">
            <column name="discount_amount" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="004-create-store-voucher" author="quangnm">
        <createTable tableName="store_voucher">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="code" type="BINARY(16)"/>
            <column name="created_time" type="DATETIME"/>
            <column name="updated_time" type="DATETIME"/>
            <column name="created_by_user_id" type="BIGINT"/>
            <column name="updated_by_user_id" type="BIGINT"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="store_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_store_voucher_store" references="store(id)"/>
            </column>
            <column name="voucher_code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="discount_percent" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="discount_amount" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="min_order_amount" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="start_at" type="DATETIME"/>
            <column name="end_at" type="DATETIME"/>
        </createTable>
        <addUniqueConstraint tableName="store_voucher" columnNames="store_id, voucher_code"
                             constraintName="uk_store_voucher_store_code"/>
    </changeSet>

</databaseChangeLog>
