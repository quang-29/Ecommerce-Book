<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-add-store-owner" author="quangnm">
        <addColumn tableName="store">
            <column name="owner_user_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="store" baseColumnNames="owner_user_id"
                                 referencedTableName="user" referencedColumnNames="id"
                                 constraintName="fk_store_owner_user"/>
        <createIndex tableName="store" indexName="idx_store_owner_user">
            <column name="owner_user_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
