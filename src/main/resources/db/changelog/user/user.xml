<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-user" author="quangnm">
        <createTable tableName="user">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="code" type="BINARY(16)"/>
            <column name="created_time" type="DATETIME"/>
            <column name="updated_time" type="DATETIME"/>
            <column name="created_by_user_id" type="BIGINT"/>
            <column name="updated_by_user_id" type="BIGINT"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="username" type="VARCHAR(255)">
                <constraints unique="true" uniqueConstraintName="uk_user_username"/>
            </column>
            <column name="password" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)">
                <constraints unique="true" uniqueConstraintName="uk_user_email"/>
            </column>
            <column name="avatar" type="VARCHAR(255)"/>
            <column name="phone_number" type="VARCHAR(255)"/>
            <column name="roles" type="VARCHAR(255)"/>
            <column name="device_token" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="002-create-roles" author="quangnm">
        <createTable tableName="roles">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="role_name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_roles_role_name"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
