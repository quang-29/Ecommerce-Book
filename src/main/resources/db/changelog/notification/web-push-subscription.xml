<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-web-push-subscription" author="quangnm">
        <createTable tableName="web_push_subscription">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="code" type="BINARY(16)"/>
            <column name="created_time" type="DATETIME"/>
            <column name="updated_time" type="DATETIME"/>
            <column name="created_by_user_id" type="BIGINT"/>
            <column name="updated_by_user_id" type="BIGINT"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="endpoint" type="VARCHAR(512)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_web_push_subscription_endpoint"/>
            </column>
            <column name="p256dh" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="auth" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-add-web-push-subscription-user-foreign-key" author="quangnm">
        <addForeignKeyConstraint baseTableName="web_push_subscription"
                                  baseColumnNames="user_id"
                                  constraintName="fk_web_push_subscription_user"
                                  referencedTableName="user"
                                  referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
